{% assign form_id = 'ContactUs-' | append: section.id %}

<div
  class="contact-us color-{{ section.settings.color_scheme }}"
  style="
    --contact-padding-top: {{ section.settings.padding_top }}px;
    --contact-padding-bottom: {{ section.settings.padding_bottom }}px;
    --contact-heading-size: {{ section.settings.heading_size }}px;
    --contact-left-width: {{ section.settings.left_width }}px;
    --contact-column-gap: {{ section.settings.column_gap }}px;
  "
>
  <div class="contact-us__inner {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <h1 class="contact-us__title">{{ section.settings.heading }}</h1>

    <div class="contact-us__grid">
      <div class="contact-us__info">
        {% if section.settings.location != blank %}
          <div class="contact-us__info-block">
            <span class="contact-us__info-label">{{ section.settings.location_label }}</span>
            <div class="contact-us__info-value">{{ section.settings.location }}</div>
          </div>
        {% endif %}

        {% if section.settings.phone != blank %}
          <div class="contact-us__info-block">
            <span class="contact-us__info-label">{{ section.settings.phone_label }}</span>
            <div class="contact-us__info-value">{{ section.settings.phone }}</div>
          </div>
        {% endif %}

        {% if section.settings.email != blank %}
          <div class="contact-us__info-block">
            <span class="contact-us__info-label">{{ section.settings.email_label }}</span>
            <div class="contact-us__info-value">
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="contact-us__form-wrapper">
        {%- form 'contact', id: form_id, class: 'contact-us__form' -%}
          <input type="hidden" name="contact[id]" value="{{ form_id }}">

          {%- if form.errors and form.id == form_id -%}
            <div class="contact-us__banner contact-us__banner--error" tabindex="-1" autofocus>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? and form.id == form_id -%}
            <div class="contact-us__banner contact-us__banner--success" tabindex="-1" autofocus>
              {{- 'blocks.contact_form.post_success' | t -}}
            </div>
          {%- endif -%}

          <div class="contact-us__field">
            <label for="{{ form_id }}-name">{{ section.settings.name_label }}</label>
            <input
              type="text"
              id="{{ form_id }}-name"
              name="contact[name]"
              autocomplete="name"
              placeholder="{{ section.settings.name_placeholder }}"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="contact-us__field">
            <label for="{{ form_id }}-email">{{ section.settings.email_field_label }}</label>
            <input
              type="email"
              id="{{ form_id }}-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              aria-required="true"
              placeholder="{{ section.settings.email_placeholder }}"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>

          <div class="contact-us__field">
            <label for="{{ form_id }}-body">{{ section.settings.message_label }}</label>
            <textarea
              rows="3"
              id="{{ form_id }}-body"
              name="contact[body]"
              placeholder="{{ section.settings.message_placeholder }}"
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="contact-us__submit">
            {{ section.settings.button_label }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-us {
    padding-block-start: var(--contact-padding-top);
    padding-block-end: var(--contact-padding-bottom);
    padding-inline: 16px;
  }

  @media screen and (min-width: 750px) {
    .contact-us {
      padding-inline: 40px;
    }
  }

  .contact-us__title {
    margin: 0 0 48px;
    font-weight: 800;
    font-size: var(--contact-heading-size);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .contact-us__grid {
    display: grid;
    grid-template-columns: var(--contact-left-width) minmax(0, 1fr);
    gap: var(--contact-column-gap);
    align-items: start;
  }

  .contact-us__info {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .contact-us__info-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
    font-size: 15px;
    opacity: 0.55;
  }

  .contact-us__info-value {
    font-size: 16px;
    line-height: 1.5;
  }

  .contact-us__info-value a {
    color: inherit;
    text-decoration: none;
  }

  .contact-us__info-value a:hover {
    text-decoration: underline;
  }

  .contact-us__form {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .contact-us__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-us__field label {
    font-weight: 700;
    font-size: 15px;
    opacity: 0.55;
  }

  .contact-us__field input,
  .contact-us__field textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    background: transparent;
    padding: 8px 0;
    font-size: 18px;
    color: inherit;
    -webkit-font-smoothing: antialiased;
  }

  .contact-us__field textarea {
    resize: vertical;
    min-height: 90px;
  }

  .contact-us__field input::placeholder,
  .contact-us__field textarea::placeholder {
    opacity: 0.4;
  }

  .contact-us__field input:focus,
  .contact-us__field textarea:focus {
    outline: none;
    border-bottom-width: 2px;
  }

  .contact-us__submit {
    align-self: flex-start;
    margin-top: 6px;
    padding: 14px 32px;
    border: 0;
    cursor: pointer;
    background: var(--color-foreground, #000);
    color: var(--color-background, #fff);
    font-size: 15px;
    font-weight: 500;
  }

  .contact-us__submit:hover {
    opacity: 0.85;
  }

  .contact-us__banner {
    padding: 12px 16px;
    font-size: 15px;
  }

  .contact-us__banner--error {
    background: rgba(220, 38, 38, 0.1);
    color: #b91c1c;
  }

  .contact-us__banner--success {
    background: rgba(22, 163, 74, 0.1);
    color: #15803d;
  }

  @media screen and (max-width: 749px) {
    .contact-us__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact us",
  "tag": "section",
  "class": "contact-us-wrapper section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact us"
    },
    {
      "type": "header",
      "content": "Location"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Location label",
      "default": "Location"
    },
    {
      "type": "richtext",
      "id": "location",
      "label": "Location",
      "default": "<p>8760 Residences, 8760 Santol St. corner Sampaloc St. San Antonio Village, Makati, Philippines, 1203</p>"
    },
    {
      "type": "header",
      "content": "Contact number"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Contact number label",
      "default": "Contact Number"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Contact number",
      "default": "+63"
    },
    {
      "type": "header",
      "content": "Email"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "loremipsum@gmail.com"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "John Doe"
    },
    {
      "type": "text",
      "id": "email_field_label",
      "label": "Email field label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "loremipsum@gmail.com"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Lorem ipsum..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "left_width",
      "label": "Left column width",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Contact us",
      "category": "Custom"
    }
  ]
}
{% endschema %}
